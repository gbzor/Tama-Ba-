# Tama Ba? — Environment variables
# Copy this file to `.env.local` for development.
# In production, set these via Vercel Project Settings → Environment Variables.
# NEVER commit `.env.local` or any file with real secrets.

# ---- Required: site URL ----
# Used for metadata + canonical links. Set to your real domain in prod.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Required in PRODUCTION: audit pepper ----
# Server-side pepper for HMAC-hashing IP addresses and audit identifiers.
# The app will refuse to start in production if this is missing or < 32 chars.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
# Or:
#   openssl rand -base64 64
AUDIT_HMAC_PEPPER=replace_me_with_a_random_64_byte_base64_string

# ---- Recommended in PRODUCTION: distributed rate limiting ----
# Without these, rate limits are per-instance in-memory only — a serverless
# cold start resets them, and warm instances do not share state.
# Provision a free Upstash Redis (https://upstash.com → Console → Create database)
# and paste the REST credentials from the database's "REST API" tab.
#
# When BOTH variables are set, the rate limiter automatically switches to
# Upstash. When unset, it falls back to in-memory (fine for local dev).
#
# UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=replace_me

# ---- OPTIONAL: future Supabase integration ----
# Uncomment and fill in when you add authentication and persistence.
# See README.md → "Going to production" for the migration steps.
#
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_me
# SUPABASE_SERVICE_ROLE_KEY=replace_me_server_only
